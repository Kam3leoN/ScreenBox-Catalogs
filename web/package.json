{
  "name": "screenbox-catalogs-web",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "export:data": "node scripts/export-static-data.mjs",
    "export:data:local": "node scripts/export-static-data.mjs --local",
    "export:data:turso": "node scripts/export-static-data.mjs --turso",
    "export:data:index": "node scripts/export-static-data.mjs --local --index-only",
    "export:data:site": "node scripts/export-static-data.mjs --local --site",
    "export:db": "node scripts/export-db-from-turso.mjs",
    "seed:turso": "node -e \"console.error('Turso retired for full catalogs — use GitHub Releases (see README)'); process.exit(1)\"",
    "seed:turso:legacy": "node scripts/seed-turso.mjs",
    "predev": "npm run export:data:site",
    "dev": "vite",
    "prebuild": "npm run export:data:site",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "@libsql/client": "^0.15.15"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@vercel/node": "^5.3.0",
    "sql.js": "^1.14.2",
    "typescript": "^5.7.3",
    "vite": "^6.0.7"
  }
}
